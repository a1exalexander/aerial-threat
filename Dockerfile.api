# syntax=docker/dockerfile:1
# API image. Build from the repo root, tagged with the revision:
#   docker build -f Dockerfile.api --build-arg GIT_SHA=$(git rev-parse --short HEAD) -t aerial-api:$(git rev-parse --short HEAD) .
# The build stage matches Dockerfile.worker (and the web image in docker-compose.prod.yml) up to `pnpm install`,
# so BuildKit shares those layers; keep the copies in sync.
ARG NODE_IMAGE=node:22.23.2-slim

FROM ${NODE_IMAGE} AS build
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 TURBO_TELEMETRY_DISABLED=1 CI=1
RUN corepack enable
WORKDIR /repo
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm-store pnpm install --frozen-lockfile --prefer-offline --store-dir /pnpm-store
RUN pnpm turbo run build --filter=@aerial/api
# Runtime deps: the app's own npm deps only (tsup bundles @aerial/* and their deps into dist), from the same frozen
# lockfile, installed into a manifest-only copy of the workspace.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm-store mkdir /prod \
  && cp package.json pnpm-lock.yaml pnpm-workspace.yaml /prod/ \
  && for d in apps/* packages/*; do mkdir -p /prod/$d && cp $d/package.json /prod/$d/; done \
  && cd /prod && pnpm install --frozen-lockfile --prefer-offline --prod --filter=@aerial/api --store-dir /pnpm-store \
  && rm -rf apps/api/node_modules/@aerial

FROM ${NODE_IMAGE}
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="aerial-api" org.opencontainers.image.revision="${GIT_SHA}"
ENV NODE_ENV=production APP_REVISION=${GIT_SHA}
WORKDIR /app/apps/api
COPY --from=build /prod/node_modules /app/node_modules
COPY --from=build /prod/apps/api/node_modules ./node_modules
COPY --from=build /repo/apps/api/package.json ./
COPY --from=build /repo/apps/api/dist ./dist
USER node
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:' + (process.env.API_PORT || 3000) + '/health/ready').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["node", "dist/main.js"]
