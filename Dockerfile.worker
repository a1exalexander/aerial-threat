# syntax=docker/dockerfile:1
# Worker image; also the one-shot migrator (`node db/migrate.js`). Build from the repo root, tagged with the revision:
#   docker build -f Dockerfile.worker --build-arg GIT_SHA=$(git rev-parse --short HEAD) -t aerial-worker:$(git rev-parse --short HEAD) .
# The build stage matches Dockerfile.api (and the web image in docker-compose.prod.yml) up to `pnpm install`,
# so BuildKit shares those layers; keep the copies in sync.
ARG NODE_IMAGE=node:22.23.2-slim

FROM ${NODE_IMAGE} AS build
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 TURBO_TELEMETRY_DISABLED=1 CI=1
RUN corepack enable
WORKDIR /repo
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm-store pnpm install --frozen-lockfile --prefer-offline --store-dir /pnpm-store
RUN pnpm turbo run build --filter=@aerial/worker
# Self-contained migration runner (postgres driver bundled); it applies ../migrations relative to itself.
RUN pnpm --filter=@aerial/worker exec tsup ../../packages/db/src/migrate.ts --no-config --format esm --platform node --target node22 --out-dir /out/db
# Runtime deps: the app's own npm deps only (tsup bundles @aerial/* and their deps into dist), from the same frozen
# lockfile, installed into a manifest-only copy of the workspace.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm-store mkdir /prod \
  && cp package.json pnpm-lock.yaml pnpm-workspace.yaml /prod/ \
  && for d in apps/* packages/*; do mkdir -p /prod/$d && cp $d/package.json /prod/$d/; done \
  && cd /prod && pnpm install --frozen-lockfile --prefer-offline --prod --filter=@aerial/worker --store-dir /pnpm-store \
  && rm -rf apps/worker/node_modules/@aerial

FROM ${NODE_IMAGE}
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="aerial-worker" org.opencontainers.image.revision="${GIT_SHA}"
ENV NODE_ENV=production APP_REVISION=${GIT_SHA}
WORKDIR /app/apps/worker
COPY --from=build /prod/node_modules /app/node_modules
COPY --from=build /prod/apps/worker/node_modules ./node_modules
COPY --from=build /repo/apps/worker/package.json ./
COPY --from=build /repo/apps/worker/dist ./dist
COPY --from=build /out/db ./db
COPY --from=build /repo/packages/db/migrations ./migrations
USER node
# `node dist/cli.js <command>` runs the admin CLI in the same image.
CMD ["node", "dist/main.js"]
