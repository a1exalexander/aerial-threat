# Copy to .env (gitignored). Never put real secrets in this file.
# api/worker/db scripts load ../../.env via --env-file-if-exists; web reads VITE_* from here too.

APP_ENV=local
LOG_LEVEL=info

# Local docker compose database (dev-only credentials).
DATABASE_URL=postgres://aerial:aerial@localhost:54329/aerial

# API
API_PORT=3000
CORS_ORIGINS=http://localhost:5173
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Worker: Vercel AI Gateway (Jev)
AI_GATEWAY_API_KEY=
AI_MODEL_ID=typesafe-ai/jev
AI_DAILY_REQUEST_LIMIT=1000
AI_CONCURRENCY=2

# Worker: Telegram (GramJS). SESSION_SECRET_REF points to a secret store entry or file, not the session itself.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_SECRET_REF=

# Worker: NEPTUN alerts (public, no key)
NEPTUN_BASE_URL=https://neptun.in.ua

# Web (public, baked into the bundle — only VITE_* values ever reach the browser)
VITE_API_URL=http://localhost:3000
VITE_MOCKS=0
