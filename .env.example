# Copy to .env (gitignored). Never put real secrets in this file.
# api, worker and `pnpm db:migrate` load the repo-root .env (tsx --env-file-if-exists); the web reads VITE_* from it.
# Server vars are validated by packages/config: an empty value means "not set" (the default applies).

# --- Common ----------------------------------------------------------------------------------------------------
# local | test | staging | production
APP_ENV=local
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# The api/worker images set NODE_ENV=production, which turns dev operator tokens off. Leave it unset locally.
# NODE_ENV=production

# --- Database ----------------------------------------------------------------------------------------------------
# Local docker compose Postgres (dev-only credentials).
DATABASE_URL=postgres://aerial:aerial@localhost:54329/aerial

# --- API -------------------------------------------------------------------------------------------------------
API_PORT=3000
# Comma list of web origins.
CORS_ORIGINS=http://localhost:5173

# --- Operator auth (API) ---------------------------------------------------------------------------------------
# OIDC access tokens for /v1/admin. All three set = on; leave empty to disable.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Dev key for `cli mint-dev-token` tokens (APP_ENV local/test only). Default: .dev-jwt-key.json at the repo root.
# DEV_JWT_KEY_FILE=/abs/path/to/.dev-jwt-key.json

# --- AI (worker): Jev through the Vercel AI Gateway --------------------------------------------------------------
AI_GATEWAY_API_KEY=
# fake = deterministic rules, no network, no cost; gateway = real calls. Empty: gateway only when a key is set and
# APP_ENV is not test, else fake.
AI_EVALUATOR=
AI_MODEL_ID=typesafe-ai/jev
AI_DAILY_REQUEST_LIMIT=1000
AI_CONCURRENCY=2

# --- Telegram (worker, GramJS) -----------------------------------------------------------------------------------
# SESSION_SECRET_REF points to a secret store entry or file, not the session itself.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_SECRET_REF=
# Live collector allowlist (public usernames, comma list).
TELEGRAM_CHANNELS=ppo_energy_poltava,h_kremenchug

# --- NEPTUN alerts (worker; public, no key) ----------------------------------------------------------------------
NEPTUN_BASE_URL=https://neptun.in.ua

# --- Kremenchuk situation (api + worker) -------------------------------------------------------------------------
# Channels whose posts feed the screen and the AI window: usernames or bare channel IDs, comma list.
KREMENCHUK_SOURCES=h_kremenchug,2432204405
# During an alert: AI at most this often, only on new posts.
SITUATION_ALERT_INTERVAL_S=60
# Without an alert: AI at most this often, only on new posts.
SITUATION_QUIET_AI_INTERVAL_S=3600
# Free rules snapshot, always.
SITUATION_RULES_INTERVAL_S=60

# --- Web (public: baked into the bundle, only VITE_* ever reaches the browser) ----------------------------------
VITE_API_URL=http://localhost:3000
# 1 = msw mock API in `vite dev`, no backend needed.
VITE_MOCKS=0

# --- Tests -------------------------------------------------------------------------------------------------------
# Admin URL of the shared Postgres; integration tests create and drop aerial_t_* databases on it. Read from the
# shell (turbo passes it through), not from this file.
# TEST_DATABASE_URL=postgres://aerial:aerial@localhost:54329/postgres

# --- Production stack (docker-compose.prod.yml) ------------------------------------------------------------------
# Compose interpolation variables. Keep them in .env.prod (gitignored), not in this dev .env, and run
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
# .env.prod also feeds the api/worker containers (env_file), so server secrets (AI_*, TELEGRAM_*, OIDC_*) go there too.
# Required, URL-safe:
# POSTGRES_PASSWORD=
# CORS origin of the web image:
# WEB_ORIGIN=http://localhost:5212
# VITE_API_URL baked into the web image:
# PUBLIC_API_URL=http://localhost:3112
# API_HOST_PORT=3112
# WEB_HOST_PORT=5212
# Image tag and revision label, e.g. $(git rev-parse --short HEAD):
# GIT_SHA=dev
# Base image of Dockerfile.api/worker: a build arg (docker build --build-arg), not a compose variable.
# NODE_IMAGE=node:22.23.2-slim
